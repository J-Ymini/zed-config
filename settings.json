// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "indent_guides": {
    "background_coloring": "indent_aware",
    "coloring": "indent_aware",
  },
  "mouse_wheel_zoom": false,
  "ui_font_family": "JetBrains Mono NL",
  "cli_default_open_behavior": "new_window",
  "diff_view_style": "split",
  "disable_ai": true,
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "agent": {
    "button": true,
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "completion_detail_alignment": "left",
  "languages": {
    "TSX": {
      "inlay_hints": {
        "edit_debounce_ms": 699,
        "show_background": false,
        "show_parameter_hints": true,
        "show_type_hints": true,
        "show_value_hints": true,
        "enabled": false,
      },
      "completions": {
        "words_min_length": 3,
      },
      "tab_size": 2,
      "hard_tabs": false,
    },
  },
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_weight": 700.0,
  "agent_servers": {},
  "colorize_brackets": true,
  "git": {
    "disable_git": false,
  },
  "selection_highlight": true,
  "current_line_highlight": "line",
  "cursor_shape": "bar",
  "text_rendering_mode": "platform_default",
  "buffer_line_height": "comfortable",
  "diagnostics": {
    "button": true,
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null,
    },
  },
  "edit_predictions": {
    "mode": "eager",
  },
  "code_actions_on_format": {
    // "source.organizeImports": true,
    "source.fixAll.eslint": true,
  },
  "format_on_save": "on",
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cx"],
        "experimental": {
          "classRegex": ["[cls|className]\\s\\:\\=\\s\"([^\"]*)"],
        },
      },
    },
    "vscode-css-language-server": {
      "settings": {
        "css": {
          "lint": {
            "unknownAtRules": "ignore",
          },
        },
      },
    },
  },
  "inlay_hints": {
    "show_parameter_hints": false,
    "show_value_hints": true,
    "enabled": false,
  },
  "git_panel": {
    "scrollbar": {
      "show": "auto",
    },
    "show_count_badge": false,
    "sort_by_path": true,
    "file_icons": true,
    "status_style": "icon",
    "button": true,
    "dock": "left",
    "tree_view": true,
    "starts_open": true,
  },
  "project_panel": {
    "git_status": true,
    "dock": "left",
    "hide_root": false,
    "hide_gitignore": false,
    "git_status_indicator": true,
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
  },
  "preview_tabs": {
    "enabled": false,
  },
  "minimap": {
    "show": "auto",
  },
  "cursor_blink": true,
  "file_types": {},
  "show_edit_predictions": true,
  "preferred_line_length": 80,
  "soft_wrap": "prefer_line",
  "tab_size": 2,
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Base Charmed Icons",
  },
  "theme": {
    "mode": "system",
    "light": "Catppuccin Frappé (Blur) [Heavy]",
    "dark": "Catppuccin Frappé (Blur) [Heavy]",
  },
  "terminal": {
    "font_weight": 700.0,
    "font_size": 12.0,
    "env": {
      "FIG_NEW_SESSION": "1",
    },
    "dock": "bottom",
    "toolbar": {
      "breadcrumbs": true,
    },
    "cursor_shape": "underline",
    "font_family": "JetBrains Mono",
  },
  "ui_font_weight": 700,
  "base_keymap": "VSCode",
  "confirm_quit": true,
  "ui_font_size": 16,
  "buffer_font_size": 13.0,
  "title_bar": {
    "show_branch_status_icon": true, // Show/hide branch icon beside branch switcher
    "show_branch_name": true, // Show/hide branch name
    "show_project_items": true, // Show/hide project host and name
    "show_onboarding_banner": true, // Show/hide onboarding banners
    "show_user_picture": true, // Show/hide user avatar
    "show_sign_in": true, // Show/hide sign-in button
    "show_menus": false, // Show/hide menus,
  },
  "experimental.theme_overrides": {
    "editor.document_highlight.write_background": "#c2c90059",
    "editor.active_line.background": "#00ff0814",
    "editor.highlighted_line.background": "#0066ff",
    "editor.document_highlight.bracket_background": "#3d8bff4d",
    "error": "#fb4a35ff",
    "error.background": "#590a0fff",
    "error.border": "#771617ff",
    "syntax": {
      "function": {
        "font_weight": 700,
      },
      "accent": {
        "background_color": "#0066ff",
      },
      "comment": {
        "font_style": "italic",
        "font_weight": 700,
      },
      "type": {
        "font_style": "italic",
        "font_weight": 700,
      },
      "punctuation.bracket": {
        "font_weight": 700,
      },
      "keyword": {
        "font_weight": 700,
      },
      "boolean": {
        "font_weight": 700,
      },
      "variable": {
        "font_weight": 700,
      },
      "enum": {
        "font_style": null,
        "font_weight": 700,
      },
      "function.builtin": {
        "font_style": null,
        "font_weight": 700,
      },
      "attribute": {
        "font_style": "italic",
        "font_weight": 700,
      },
      "constant": {
        "font_style": null,
        "font_weight": 700,
      },
      "constructor": {
        "font_style": null,
        "font_weight": 700,
      },
      "namespace": {
        "font_style": null,
        "font_weight": 700,
      },
      "number": {
        "font_style": null,
        "font_weight": 700,
      },
      "property": {
        "font_style": null,
        "font_weight": 700,
      },
      "operator": {
        "font_style": null,
        "font_weight": 700,
      },
    },
  },
  "file_finder": {
    "file_icons": true,
    "modal_max_width": "medium",
  },
  "theme_overrides": {
    "Catppuccin Frappé (Blur) [Heavy]": {
      "syntax": {
        "tag.jsx": {
          "color": "#EA999C",
        },
        "tag.component.jsx": {
          "color": "#E5C890",
        },
      },
    },
  },
}
